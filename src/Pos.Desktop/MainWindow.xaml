<Window x:Class="Pos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyPOS" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="MyPOS" Style="{StaticResource TitleText}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Not signed in" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Nav rail -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="12,16">
                <RadioButton x:Name="NavDashboard" Content="Dashboard" Style="{StaticResource NavButton}" IsChecked="True" Margin="0,0,0,4" />
                <RadioButton x:Name="NavSell" Content="Sell" Style="{StaticResource NavButton}" Margin="0,0,0,4" />
                <RadioButton x:Name="NavProducts" Content="Products" Style="{StaticResource NavButton}" Margin="0,0,0,4" />
                <RadioButton x:Name="NavStock" Content="Stock" Style="{StaticResource NavButton}" Margin="0,0,0,4" />
                <RadioButton x:Name="NavCustomers" Content="Customers" Style="{StaticResource NavButton}" Margin="0,0,0,4" />
                <RadioButton x:Name="NavReports" Content="Reports" Style="{StaticResource NavButton}" Margin="0,0,0,4" />
                <RadioButton x:Name="NavSettings" Content="Settings" Style="{StaticResource NavButton}" Margin="0,0,0,4" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <TextBlock Text="Welcome" Style="{StaticResource DisplayText}" />
                <TextBlock Text="Get the shop ready to sell." Style="{StaticResource CaptionText}" Margin="0,4,0,20" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Setup checklist" Style="{StaticResource TitleText}" />
                        <TextBlock Text="Work through these to be ready on day one." Style="{StaticResource CaptionText}" Margin="0,4,0,16" />

                        <StackPanel>
                            <CheckBox Content="Shop details (name, phone, KRA PIN)" Margin="0,6" />
                            <CheckBox Content="Add products or import from Excel" Margin="0,6" />
                            <CheckBox Content="Add suppliers" Margin="0,6" />
                            <CheckBox Content="Add credit customers" Margin="0,6" />
                            <CheckBox Content="Set up automatic backups" Margin="0,6" />
                            <CheckBox Content="Print a test receipt" Margin="0,6" />
                        </StackPanel>

                        <Button Content="Start selling" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,20,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
