<UserControl x:Class="Pos.Desktop.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Audit log" Style="{StaticResource Text.Display}" />
                <TextBlock Text="Every important action, with who did it and when."
                           Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource Button.Secondary}"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Icon.Refresh}" FontFamily="{StaticResource Font.Icon}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Large}">
            <DataGrid ItemsSource="{Binding Entries}"
                      Style="{StaticResource DataGrid.Default}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Binding="{Binding WhenDisplay}" Width="160" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="200" />
                    <DataGridTextColumn Header="Who" Binding="{Binding UserName}" Width="140" />
                    <DataGridTextColumn Header="Details" Binding="{Binding NewValue}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Showing last 200 entries. Older entries remain in the database."
                   Style="{StaticResource Text.Caption}"
                   Margin="0,12,0,0" />
    </Grid>
</UserControl>
