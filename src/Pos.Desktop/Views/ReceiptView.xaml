<Window x:Class="Pos.Desktop.Views.ReceiptView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt" Height="620" Width="380"
        MinHeight="500" MinWidth="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#E2E8F0"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="ReceiptPaper"
                Grid.Row="0"
                Background="White"
                Padding="20"
                Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.15" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel TextElement.FontFamily="Consolas, Courier New" TextElement.Foreground="#111">
                    <TextBlock Text="{Binding ShopName}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ShopDetails}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,12" />

                    <TextBlock Text="------------------------------------------------" FontSize="12" HorizontalAlignment="Center" />

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Receipt: " FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding ReceiptNumber}" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Date:    " FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding CompletedAt}" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="------------------------------------------------" FontSize="12" HorizontalAlignment="Center" Margin="0,6" />

                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding ProductName}" FontSize="12" TextWrapping="Wrap" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding QtyDisplay, StringFormat='  {0} x'}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding PriceDisplay}" FontSize="12" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding TotalDisplay}" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="------------------------------------------------" FontSize="12" HorizontalAlignment="Center" Margin="0,6" />

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Subtotal:" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding SubtotalDisplay}" FontSize="12" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tax:" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding TaxDisplay}" FontSize="12" />
                    </Grid>
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TOTAL:" FontSize="14" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalDisplay}" FontSize="14" FontWeight="Bold" />
                    </Grid>

                    <TextBlock Text="------------------------------------------------" FontSize="12" HorizontalAlignment="Center" Margin="0,6" />

                    <ItemsControl ItemsSource="{Binding Payments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,2" Visibility="{Binding HasChange, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Change:" FontSize="12" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding ChangeDisplay}" FontSize="12" FontWeight="Bold" />
                    </Grid>

                    <TextBlock Text="------------------------------------------------" FontSize="12" HorizontalAlignment="Center" Margin="0,6" />

                    <TextBlock Text="Thank you for your business!" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,4" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Print"
                    Click="OnPrint"
                    Style="{StaticResource Button.Secondary}"
                    Padding="16,8" Margin="0,0,8,0" />
            <Button Content="New sale"
                    Click="OnNewSale"
                    Style="{StaticResource Button.Primary}"
                    Padding="16,8"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
