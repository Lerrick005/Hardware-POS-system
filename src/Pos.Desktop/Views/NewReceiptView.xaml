<Window x:Class="Pos.Desktop.Views.NewReceiptView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record delivery" Height="680" Width="920"
        MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource Brush.Canvas}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Record a delivery" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Enter what came in. Stock updates the moment you save."
                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Supplier + repeat + date + supplier ref -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Supplier" Style="{StaticResource Text.Label}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Suppliers}"
                      SelectedItem="{Binding SelectedSupplier}"
                      DisplayMemberPath="Name" Padding="8,6"
                      FontSize="{StaticResource Font.Size.Body}" />
            <Button Grid.Column="2" Content="Repeat last" Margin="8,0,0,0"
                    Command="{Binding RepeatLastDeliveryCommand}"
                    Style="{StaticResource Button.Secondary}" Padding="12,6" />

            <TextBlock Grid.Column="3" Text="Date" Style="{StaticResource Text.Label}"
                       VerticalAlignment="Center" Margin="16,0,8,0" />
            <TextBox Grid.Column="4" Text="{Binding BusinessDate, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6"
                     Background="{StaticResource Brush.Surface}"
                     BorderBrush="{StaticResource Brush.Border.Default}"
                     BorderThickness="1" />

            <TextBlock Grid.Column="6" Text="Supplier invoice #" Style="{StaticResource Text.Label}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="7" Text="{Binding SupplierRef, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6"
                     Background="{StaticResource Brush.Surface}"
                     BorderBrush="{StaticResource Brush.Border.Default}"
                     BorderThickness="1" />
        </Grid>

        <!-- Product picker -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Add a product" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding PickerSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Background="{StaticResource Brush.Surface}"
                             BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" />
                    <ListBox ItemsSource="{Binding PickerResults}"
                             SelectedItem="{Binding PickerProduct}"
                             MaxHeight="120" Margin="0,8,0,0"
                             BorderBrush="{StaticResource Brush.Border.Default}"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Text="{Binding StockDisplay}"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <Button Grid.Column="2" Content="Add line"
                        Command="{Binding AddLineCommand}"
                        Style="{StaticResource Button.Primary}"
                        VerticalAlignment="Top" Padding="18,9" />
            </Grid>
        </Border>

        <!-- Lines grid -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Lines}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding Product.Name}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Current stock" Binding="{Binding CurrentStockDisplay}" Width="120" IsReadOnly="True"
                                        CellStyle="{StaticResource DataGrid.NumericCell}"
                                        HeaderStyle="{StaticResource DataGrid.NumericColumnHeader}" />
                    <DataGridTextColumn Header="Receive" Binding="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                        CellStyle="{StaticResource DataGrid.NumericCell}"
                                        HeaderStyle="{StaticResource DataGrid.NumericColumnHeader}" />
                    <DataGridTextColumn Header="New stock" Binding="{Binding NewStockDisplay}" Width="120" IsReadOnly="True"
                                        CellStyle="{StaticResource DataGrid.NumericCell}"
                                        HeaderStyle="{StaticResource DataGrid.NumericColumnHeader}" />
                    <DataGridTextColumn Header="Unit cost (KES)" Binding="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}" Width="130"
                                        CellStyle="{StaticResource DataGrid.NumericCell}"
                                        HeaderStyle="{StaticResource DataGrid.NumericColumnHeader}" />
                    <DataGridTextColumn Header="Line total" Binding="{Binding LineTotalDisplay}" Width="120" IsReadOnly="True"
                                        CellStyle="{StaticResource DataGrid.NumericCell}"
                                        HeaderStyle="{StaticResource DataGrid.NumericColumnHeader}" />
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove"
                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,4" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer: paid / total / save -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Brush.Danger.Subtle}"
                    BorderBrush="{StaticResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Medium}"
                    Padding="10"
                    VerticalAlignment="Center"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToCollapsedConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Paid now (KES)" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding PaidText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" TextAlignment="Right"
                             Background="{StaticResource Brush.Surface}"
                             BorderBrush="{StaticResource Brush.Border.Default}"
                             BorderThickness="1" />
                    <Button Grid.Column="2" Content="Paid in full"
                            Command="{Binding PayInFullCommand}"
                            Style="{StaticResource Button.Ghost}"
                            Height="26" Padding="8,0"
                            Margin="6,0,0,0"
                            FontSize="{StaticResource Font.Size.Caption}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Still to pay:" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="1" Text="{Binding RemainingDueDisplay, StringFormat='{}{0} KES'}"
                               Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Right"
                               FontWeight="SemiBold" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Delivery total" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding TotalDisplay, StringFormat='{}{0} KES'}"
                               Style="{StaticResource Text.Title}"
                               HorizontalAlignment="Right" />
                </StackPanel>
                <Button Content="Cancel" Click="OnCancel"
                        Style="{StaticResource Button.Secondary}"
                        Padding="16,10" Margin="0,0,8,0" />
                <Button Content="Save delivery"
                        Command="{Binding SaveCommand}"
                        IsDefault="True"
                        Style="{StaticResource Button.Primary.Large}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InvertBoolConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
