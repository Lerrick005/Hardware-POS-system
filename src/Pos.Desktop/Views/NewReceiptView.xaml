<Window x:Class="Pos.Desktop.Views.NewReceiptView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New goods receipt" Height="580" Width="880"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Record a delivery" Style="{StaticResource TitleText}" />
            <TextBlock Text="Stock updates immediately. Weighted average cost is recalculated per line."
                       Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Business date" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding BusinessDate, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Background="White"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
            <TextBlock Grid.Column="3" Text="Supplier ref (optional)" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="4" Text="{Binding SupplierRef, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Background="White"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Pick product" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding PickerSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Background="White"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                    <ListBox ItemsSource="{Binding PickerResults}"
                             SelectedItem="{Binding PickerProduct}"
                             DisplayMemberPath="Name"
                             MaxHeight="90" Margin="0,6,0,0"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                </StackPanel>

                <Button Grid.Column="2" Content="Add line"
                        Command="{Binding AddLineCommand}"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Top" Padding="18,9" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Lines}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="36"
                      AlternatingRowBackground="#FAFBFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding Product.Name}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                    <DataGridTextColumn Header="Unit cost (KES)" Binding="{Binding UnitCostText, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                    <DataGridTextColumn Header="Line total" Binding="{Binding LineTotalDisplay}" Width="110" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove"
                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,4" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FFF1F1" BorderBrush="#F1B0B0" BorderThickness="1"
                    CornerRadius="6" Padding="10"
                    VerticalAlignment="Center"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToCollapsedConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="Total: " Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalDisplay}" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Cancel" Click="OnCancel" Padding="16,9" Margin="0,0,8,0" />
                <Button Content="Save receipt" Command="{Binding SaveCommand}" IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InvertBoolConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
