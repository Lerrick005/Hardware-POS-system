<Window x:Class="Pos.Desktop.Views.StatementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer statement" Height="640" Width="820"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Statement" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding CustomerName}" Style="{StaticResource Text.Title}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Phone}"
                           Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{StaticResource Brush.Accent.Subtle}"
                    CornerRadius="{StaticResource Radius.Medium}"
                    Padding="16,10"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Current balance"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.Accent}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding BalanceDisplay}"
                                   Style="{StaticResource Text.NumericStrong}"
                                   Foreground="{StaticResource Brush.Accent}" />
                        <TextBlock Text=" KES"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{StaticResource Brush.Accent}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Ledger grid ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Large}">
            <DataGrid ItemsSource="{Binding Rows}"
                      Style="{StaticResource DataGrid.Default}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="110" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                    <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="180" />
                    <DataGridTextColumn Header="Debit"
                                        Binding="{Binding DebitDisplay}"
                                        Width="110"
                                        CellStyle="{StaticResource DataGrid.NumericCell}"
                                        HeaderStyle="{StaticResource DataGrid.NumericColumnHeader}" />
                    <DataGridTextColumn Header="Credit"
                                        Binding="{Binding CreditDisplay}"
                                        Width="110"
                                        CellStyle="{StaticResource DataGrid.NumericCell}"
                                        HeaderStyle="{StaticResource DataGrid.NumericColumnHeader}" />
                    <DataGridTextColumn Header="Balance"
                                        Binding="{Binding BalanceDisplay}"
                                        Width="120"
                                        CellStyle="{StaticResource DataGrid.NumericCell}"
                                        HeaderStyle="{StaticResource DataGrid.NumericColumnHeader}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ===== Footer ===== -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       Style="{StaticResource Text.Caption}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Print"
                        Style="{StaticResource Button.Secondary}"
                        Padding="16,8" Margin="0,0,8,0"
                        IsEnabled="False"
                        ToolTip="Printing is not available yet — coming with the printer setup screen." />
                <Button Content="Close" Click="OnClose"
                        Style="{StaticResource Button.Primary}"
                        Padding="16,8" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
