<Window x:Class="Pos.Desktop.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="220" Width="440"
        MinHeight="180" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="36" Height="36" CornerRadius="{StaticResource Radius.Medium}"
                    Background="{StaticResource Brush.Warning.Subtle}"
                    Margin="0,0,12,0">
                <TextBlock Text="{StaticResource Icon.Warning}"
                           FontFamily="{StaticResource Font.Icon}"
                           FontSize="18"
                           Foreground="{StaticResource Brush.Warning}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TitleText"
                       Text="Are you sure?"
                       Style="{StaticResource Text.Title}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   Text="This action cannot be undone."
                   Style="{StaticResource Text.Body}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.Text.Secondary}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="OnCancel"
                    Style="{StaticResource Button.Secondary}"
                    Padding="16,8" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton"
                    Content="Continue"
                    Click="OnConfirm"
                    Style="{StaticResource Button.Primary}"
                    Padding="16,8"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
