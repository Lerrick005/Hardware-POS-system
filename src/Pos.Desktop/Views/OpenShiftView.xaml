<Window x:Class="Pos.Desktop.Views.OpenShiftView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open shift" Height="380" Width="440"
        MinHeight="320" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Canvas}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Open shift" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Count the cash in the drawer before your first sale."
                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Opening float (KES) *" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding OpeningFloatText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="12,10" Margin="0,4,0,4"
                     FontSize="{StaticResource Font.Size.BodyLarge}"
                     Background="{StaticResource Brush.Surface}"
                     BorderBrush="{StaticResource Brush.Border.Default}"
                     BorderThickness="1" />
            <TextBlock Text="Cash already in the drawer before you start. Enter 0 if empty."
                       Style="{StaticResource Text.Caption}"
                       Margin="0,0,0,12" />

            <Border Background="{StaticResource Brush.Danger.Subtle}"
                    BorderBrush="{StaticResource Brush.Danger}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Medium}"
                    Padding="10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToCollapsedConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Brush.Danger}"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource Font.Size.Body}" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel"
                    Style="{StaticResource Button.Secondary}"
                    Padding="16,8" Margin="0,0,8,0" />
            <Button Content="Start shift"
                    Command="{Binding StartCommand}"
                    IsDefault="True"
                    Style="{StaticResource Button.Primary}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InvertBoolConverter}}" />
        </StackPanel>
    </Grid>
</Window>
