<UserControl x:Class="Pos.Desktop.Views.SettingsHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- ===== Hub (4 cards) — visible when no sub-view open ===== -->
        <Grid Visibility="{Binding IsAtHub, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32,28,32,28">
                <TextBlock Text="Settings" Style="{StaticResource Text.Display}" />
                <TextBlock Text="Manage your shop, staff and data."
                           Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="4" Margin="32,0,32,32" VerticalAlignment="Top">
                <!-- Staff card -->
                <Button Command="{Binding OpenStaffCommand}"
                        Style="{StaticResource SettingsCardButton}"
                        Margin="0,0,16,0">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="{StaticResource Radius.Medium}"
                                Background="{StaticResource Brush.Accent.Subtle}"
                                HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="{StaticResource Icon.People}"
                                       FontFamily="{StaticResource Font.Icon}"
                                       FontSize="20"
                                       Foreground="{StaticResource Brush.Accent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Staff" Style="{StaticResource Text.Subtitle}" />
                        <TextBlock Text="{Binding StaffSummary}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Open →" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Accent}" />
                    </StackPanel>
                </Button>

                <!-- Shop & Backup card -->
                <Button Command="{Binding OpenShopCommand}"
                        Style="{StaticResource SettingsCardButton}"
                        Margin="0,0,16,0">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="{StaticResource Radius.Medium}"
                                Background="{StaticResource Brush.Accent.Subtle}"
                                HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="{StaticResource Icon.Settings}"
                                       FontFamily="{StaticResource Font.Icon}"
                                       FontSize="20"
                                       Foreground="{StaticResource Brush.Accent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Shop &amp; Backup" Style="{StaticResource Text.Subtitle}" />
                        <TextBlock Text="{Binding ShopSummary}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Open →" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Accent}" />
                    </StackPanel>
                </Button>

                <!-- Audit card -->
                <Button Command="{Binding OpenAuditCommand}"
                        Style="{StaticResource SettingsCardButton}"
                        Margin="0,0,16,0">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="{StaticResource Radius.Medium}"
                                Background="{StaticResource Brush.Accent.Subtle}"
                                HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="{StaticResource Icon.Document}"
                                       FontFamily="{StaticResource Font.Icon}"
                                       FontSize="20"
                                       Foreground="{StaticResource Brush.Accent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Audit" Style="{StaticResource Text.Subtitle}" />
                        <TextBlock Text="{Binding AuditSummary}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Open →" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Accent}" />
                    </StackPanel>
                </Button>

                <!-- About card -->
                <Button Command="{Binding OpenAboutCommand}"
                        Style="{StaticResource SettingsCardButton}">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="{StaticResource Radius.Medium}"
                                Background="{StaticResource Brush.Accent.Subtle}"
                                HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="{StaticResource Icon.Info}"
                                       FontFamily="{StaticResource Font.Icon}"
                                       FontSize="20"
                                       Foreground="{StaticResource Brush.Accent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="About" Style="{StaticResource Text.Subtitle}" />
                        <TextBlock Text="{Binding AboutSummary}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Open →" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Accent}" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>

        <!-- ===== Sub-view (Staff / Shop / Audit / About) ===== -->
        <Grid Visibility="{Binding IsAtHub, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border.Default}"
                    BorderThickness="0,0,0,1"
                    Padding="24,12">
                <Button Command="{Binding BackToHubCommand}"
                        Style="{StaticResource Button.Ghost}"
                        HorizontalAlignment="Left"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.ChevronLeft}"
                                   FontFamily="{StaticResource Font.Icon}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="Back to Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentSubView}" />
        </Grid>
    </Grid>
</UserControl>
