<Window x:Class="Pos.Desktop.Views.AddCustomerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add customer" Height="480" Width="520"
        MinHeight="440" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Add a customer" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Used for credit sales. Opening balance carries old debt from your notebook."
                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Name *" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" Margin="0,4,0,12"
                         Background="{StaticResource Brush.Surface}"
                         BorderBrush="{StaticResource Brush.Border.Default}"
                         BorderThickness="1"
                         FontSize="{StaticResource Font.Size.Body}" />

                <TextBlock Text="Phone" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" Margin="0,4,0,12"
                         Background="{StaticResource Brush.Surface}"
                         BorderBrush="{StaticResource Brush.Border.Default}"
                         BorderThickness="1"
                         FontSize="{StaticResource Font.Size.Body}" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Price type" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding PriceTiers}"
                                  SelectedItem="{Binding SelectedPriceTier}"
                                  DisplayMemberPath="Name"
                                  Padding="8,6" Margin="0,4,0,0"
                                  FontSize="{StaticResource Font.Size.Body}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Credit limit (KES)" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding CreditLimitText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" Margin="0,4,0,0"
                                 Background="{StaticResource Brush.Surface}"
                                 BorderBrush="{StaticResource Brush.Border.Default}"
                                 BorderThickness="1"
                                 FontSize="{StaticResource Font.Size.Body}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Opening balance (KES)" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding OpeningBalanceText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" Margin="0,4,0,12"
                         Background="{StaticResource Brush.Surface}"
                         BorderBrush="{StaticResource Brush.Border.Default}"
                         BorderThickness="1"
                         FontSize="{StaticResource Font.Size.Body}" />
                <TextBlock Text="Enter the amount this customer already owes you. Leave 0 for a new customer."
                           Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap" Margin="0,0,0,12" />

                <TextBlock Text="Notes" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" Margin="0,4,0,0"
                         Height="60"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource Brush.Surface}"
                         BorderBrush="{StaticResource Brush.Border.Default}"
                         BorderThickness="1"
                         FontSize="{StaticResource Font.Size.Body}" />

                <Border Background="{StaticResource Brush.Danger.Subtle}"
                        BorderBrush="{StaticResource Brush.Danger}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Padding="10"
                        Margin="0,12,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToCollapsedConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource Brush.Danger}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Body}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel"
                    Style="{StaticResource Button.Secondary}"
                    Padding="16,8" Margin="0,0,8,0" />
            <Button Content="Save customer"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Style="{StaticResource Button.Primary}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InvertBoolConverter}}" />
        </StackPanel>
    </Grid>
</Window>
