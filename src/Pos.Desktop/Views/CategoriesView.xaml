<Window x:Class="Pos.Desktop.Views.CategoriesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Categories" Height="560" Width="520"
        MinHeight="440" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Categories" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Group products to find them faster. Categories are optional per product."
                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Input row: add new, or edit existing -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.Surface.Sunken}"
                CornerRadius="{StaticResource Radius.Medium}"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         Background="{StaticResource Brush.Surface}"
                         BorderBrush="{StaticResource Brush.Border.Default}"
                         BorderThickness="1"
                         FontSize="{StaticResource Font.Size.Body}"
                         VerticalContentAlignment="Center"
                         Height="36" />

                <Button Grid.Column="1"
                        Content="{Binding PrimaryButtonText}"
                        Command="{Binding AddOrSaveCommand}"
                        Style="{StaticResource Button.Primary}"
                        Padding="14,8"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" />

                <Button Grid.Column="2"
                        Content="Cancel"
                        Command="{Binding CancelEditCommand}"
                        Style="{StaticResource Button.Secondary}"
                        Padding="14,8"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>

        <!-- Category list -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Large}">
            <DataGrid ItemsSource="{Binding Categories}"
                      Style="{StaticResource DataGrid.Default}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Products"
                                        Binding="{Binding ProductCount}"
                                        Width="90"
                                        CellStyle="{StaticResource DataGrid.NumericCell}"
                                        HeaderStyle="{StaticResource DataGrid.NumericColumnHeader}" />
                    <DataGridTemplateColumn Header="" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Edit"
                                            Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.Ghost}"
                                            Height="28" Padding="10,0"
                                            Margin="0,0,4,0" />
                                    <Button Content="Archive"
                                            Command="{Binding DataContext.ArchiveCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.Ghost}"
                                            Height="28" Padding="10,0"
                                            Foreground="{StaticResource Brush.Danger}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer: error + status + close -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <Border Background="{StaticResource Brush.Danger.Subtle}"
                        BorderBrush="{StaticResource Brush.Danger}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Padding="10"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToCollapsedConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource Brush.Danger}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Body}" />
                </Border>
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource Text.Caption}"
                           Margin="2,6,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Close"
                    Click="OnClose"
                    Style="{StaticResource Button.Secondary}"
                    Padding="16,8"
                    Margin="16,0,0,0"
                    IsCancel="True"
                    VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</Window>
