<Window x:Class="Pos.Desktop.Views.RecordPaymentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record payment" Height="520" Width="500"
        MinHeight="460" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Record payment" Style="{StaticResource Text.Title}" />
            <TextBlock Text="{Binding CustomerName}"
                       Style="{StaticResource Text.Subtitle}"
                       Foreground="{StaticResource Brush.Text.Secondary}"
                       Margin="0,4,0,0" />
            <Border Background="{StaticResource Brush.Accent.Subtle}"
                    CornerRadius="{StaticResource Radius.Medium}"
                    Padding="12,8"
                    Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Current balance: "
                               Style="{StaticResource Text.Body}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentBalanceDisplay}"
                               Style="{StaticResource Text.NumericStrong}"
                               Foreground="{StaticResource Brush.Accent}"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" KES"
                               Style="{StaticResource Text.Body}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Amount received (KES) *" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" Margin="0,4,0,12"
                         FontSize="{StaticResource Font.Size.BodyLarge}"
                         Background="{StaticResource Brush.Surface}"
                         BorderBrush="{StaticResource Brush.Border.Default}"
                         BorderThickness="1" />

                <TextBlock Text="Payment method" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding Methods}"
                          SelectedItem="{Binding SelectedMethod}"
                          Padding="8,6" Margin="0,4,0,12"
                          FontSize="{StaticResource Font.Size.Body}" />

                <StackPanel Visibility="{Binding ReferenceRequired, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ReferenceLabel}" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,4,0,12"
                             Background="{StaticResource Brush.Surface}"
                             BorderBrush="{StaticResource Brush.Border.Default}"
                             BorderThickness="1"
                             FontSize="{StaticResource Font.Size.Body}" />
                </StackPanel>

                <TextBlock Text="Notes (optional)" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" Margin="0,4,0,12"
                         Height="60"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource Brush.Surface}"
                         BorderBrush="{StaticResource Brush.Border.Default}"
                         BorderThickness="1"
                         FontSize="{StaticResource Font.Size.Body}" />

                <Border Background="{StaticResource Brush.Danger.Subtle}"
                        BorderBrush="{StaticResource Brush.Danger}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Padding="10"
                        Margin="0,4,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToCollapsedConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource Brush.Danger}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Body}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel"
                    Style="{StaticResource Button.Secondary}"
                    Padding="16,8" Margin="0,0,8,0" />
            <Button Content="Record payment"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Style="{StaticResource Button.Primary}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InvertBoolConverter}}" />
        </StackPanel>
    </Grid>
</Window>
