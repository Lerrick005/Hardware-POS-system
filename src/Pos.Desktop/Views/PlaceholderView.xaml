<UserControl x:Class="Pos.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayText}" />
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" />
        </Border>
    </StackPanel>
</UserControl>
