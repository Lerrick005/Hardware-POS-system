<Window x:Class="Pos.Desktop.Views.AddProductView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="820" Width="760"
        MinHeight="640" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource Brush.Canvas}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Product details, prices, and any extra units it can be sold in."
                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ===== Basic details ===== -->
                <TextBlock Text="Product name *" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" Margin="0,4,0,12"
                         Background="{StaticResource Brush.Surface}"
                         BorderBrush="{StaticResource Brush.Border.Default}"
                         BorderThickness="1"
                         FontSize="{StaticResource Font.Size.Body}" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Code (optional)" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" Margin="0,4,0,0"
                                 Background="{StaticResource Brush.Surface}"
                                 BorderBrush="{StaticResource Brush.Border.Default}"
                                 BorderThickness="1" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Barcode (optional)" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsEditMode}"
                                 Padding="8,6" Margin="0,4,0,0"
                                 Background="{StaticResource Brush.Surface}"
                                 BorderBrush="{StaticResource Brush.Border.Default}"
                                 BorderThickness="1" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Text.Label}">
                            <Run Text="Sold by (base unit) *" />
                        </TextBlock>
                        <ComboBox ItemsSource="{Binding Units}"
                                  SelectedItem="{Binding SelectedUnit}"
                                  IsEnabled="{Binding IsEditMode, Converter={StaticResource InvertBoolConverter}}"
                                  DisplayMemberPath="Name"
                                  Padding="8,6" Margin="0,4,0,0"
                                  FontSize="{StaticResource Font.Size.Body}" />
                        <TextBlock Text="Cannot be changed after the product is created."
                                   Style="{StaticResource Text.Caption}"
                                   FontSize="11" Margin="0,2,0,0"
                                   Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Category (optional)" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberPath="Name"
                                  Padding="8,6" Margin="0,4,0,0"
                                  FontSize="{StaticResource Font.Size.Body}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Low stock alert (in base units)" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" Margin="0,4,0,16"
                         Width="180" HorizontalAlignment="Left"
                         Background="{StaticResource Brush.Surface}"
                         BorderBrush="{StaticResource Brush.Border.Default}"
                         BorderThickness="1" />

                <!-- ===== Prices for the base unit ===== -->
                <Border Background="{StaticResource Brush.Surface.Sunken}"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Padding="12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Base unit prices (KES)"
                                   Style="{StaticResource Text.Label}"
                                   Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Retail" Style="{StaticResource Text.Caption}" Margin="0,0,0,2" />
                                <TextBox Text="{Binding RetailPriceText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6"
                                         Background="{StaticResource Brush.Surface}"
                                         BorderBrush="{StaticResource Brush.Border.Default}"
                                         BorderThickness="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Wholesale" Style="{StaticResource Text.Caption}" Margin="0,0,0,2" />
                                <TextBox Text="{Binding WholesalePriceText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6"
                                         Background="{StaticResource Brush.Surface}"
                                         BorderBrush="{StaticResource Brush.Border.Default}"
                                         BorderThickness="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Contractor" Style="{StaticResource Text.Caption}" Margin="0,0,0,2" />
                                <TextBox Text="{Binding ContractorPriceText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6"
                                         Background="{StaticResource Brush.Surface}"
                                         BorderBrush="{StaticResource Brush.Border.Default}"
                                         BorderThickness="1" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Price per 1 of the base unit. Leave blank for tiers the shop does not use."
                                   Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- ===== Selling units (alternatives) ===== -->
                <Border BorderBrush="{StaticResource Brush.Accent.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Padding="12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Other units this product can be sold in"
                                           Style="{StaticResource Text.Subtitle}" />
                                <TextBlock Text="Optional. E.g. 1 Box = 120 pieces, 1 kg = 25 pieces. Each unit has its own prices."
                                           Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+ Add unit"
                                    Command="{Binding AddSellingUnitCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    Padding="12,6"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Column headers (visible only when rows exist) -->
                        <Grid Margin="0,4,0,4">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SellingUnits.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SellingUnits.Count}" Value="1">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SellingUnits.Count}" Value="2">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SellingUnits.Count}" Value="3">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SellingUnits.Count}" Value="4">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SellingUnits.Count}" Value="5">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Unit" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="1 = n" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Retail (KES)" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="Wholesale" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="8" Text="Contractor" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SellingUnits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding AvailableUnits}"
                                                  SelectedItem="{Binding SelectedUnit}"
                                                  DisplayMemberPath="Name"
                                                  Padding="6,4" />

                                        <TextBox Grid.Column="2"
                                                 Text="{Binding FactorText, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,4"
                                                 Background="{StaticResource Brush.Surface}"
                                                 BorderBrush="{StaticResource Brush.Border.Default}"
                                                 BorderThickness="1"
                                                 TextAlignment="Right" />

                                        <TextBox Grid.Column="4"
                                                 Text="{Binding RetailPriceText, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,4"
                                                 Background="{StaticResource Brush.Surface}"
                                                 BorderBrush="{StaticResource Brush.Border.Default}"
                                                 BorderThickness="1"
                                                 TextAlignment="Right" />

                                        <TextBox Grid.Column="6"
                                                 Text="{Binding WholesalePriceText, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,4"
                                                 Background="{StaticResource Brush.Surface}"
                                                 BorderBrush="{StaticResource Brush.Border.Default}"
                                                 BorderThickness="1"
                                                 TextAlignment="Right" />

                                        <TextBox Grid.Column="8"
                                                 Text="{Binding ContractorPriceText, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,4"
                                                 Background="{StaticResource Brush.Surface}"
                                                 BorderBrush="{StaticResource Brush.Border.Default}"
                                                 BorderThickness="1"
                                                 TextAlignment="Right" />

                                        <Button Grid.Column="10"
                                                Content="×"
                                                Command="{Binding DataContext.RemoveSellingUnitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Button.Ghost}"
                                                Height="28" Padding="6,0"
                                                Foreground="{StaticResource Brush.Danger}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <TextBlock Text="No extra units yet. The product is only sold in its base unit."
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SellingUnits.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ===== Error banner ===== -->
                <Border Background="{StaticResource Brush.Danger.Subtle}"
                        BorderBrush="{StaticResource Brush.Danger}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Padding="10"
                        Margin="0,4,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToCollapsedConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource Brush.Danger}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Body}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel"
                    Style="{StaticResource Button.Secondary}"
                    Padding="16,8" Margin="0,0,8,0" />
            <Button Content="{Binding SaveButtonText}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Style="{StaticResource Button.Primary}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InvertBoolConverter}}" />
        </StackPanel>
    </Grid>
</Window>

