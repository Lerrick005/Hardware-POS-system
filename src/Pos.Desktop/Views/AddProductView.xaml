<Window x:Class="Pos.Desktop.Views.AddProductView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add product" Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="24">
        <TextBlock Text="Add a new product" Style="{StaticResource TitleText}" />
        <TextBlock Text="Essentials only. Prices and barcodes can be added later." Style="{StaticResource CaptionText}" Margin="0,4,0,20" />

        <TextBlock Text="Name *" Style="{StaticResource CaptionText}" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,4,0,12"
                 Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="SKU (optional)" Style="{StaticResource CaptionText}" />
                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,4,0,0"
                         Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Barcode (optional)" Style="{StaticResource CaptionText}" />
                <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,4,0,0"
                         Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Base unit *" Style="{StaticResource CaptionText}" />
                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}"
                          DisplayMemberPath="Name" Padding="10,8" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Category (optional)" Style="{StaticResource CaptionText}" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name" Padding="10,8" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Reorder level (whole units)" Style="{StaticResource CaptionText}" />
        <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,4,0,20"
                 Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                 HorizontalAlignment="Left" Width="180" />

        <Border Background="#FFF1F1" BorderBrush="#F1B0B0" BorderThickness="1" CornerRadius="6" Padding="10"
                Margin="0,0,0,16"
                Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToCollapsedConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancel" Padding="16,10" Margin="0,0,8,0" />
            <Button Content="Save product" Command="{Binding SaveCommand}" IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InvertBoolConverter}}" />
        </StackPanel>
    </StackPanel>
</Window>
