<UserControl x:Class="Pos.Desktop.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,28,32,24" MaxWidth="700" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="About" Style="{StaticResource Text.Display}" />
                <TextBlock Text="Version, database and system information."
                           Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="MyPOS" Style="{StaticResource Text.Title}" Margin="0,0,0,4" />
                    <TextBlock Text="Point of Sale and Stock Management" Style="{StaticResource Text.Caption}"
                               Margin="0,0,0,20" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Version" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource Text.Body}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Database schema" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1" Text="{Binding SchemaVersion}" Style="{StaticResource Text.Body}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Database size" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1" Text="{Binding DbSizeDisplay}" Style="{StaticResource Text.Body}" />
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Database path" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1" Text="{Binding DbPath}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Border Background="{StaticResource Brush.Surface.Sunken}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Padding="12">
                        <TextBlock Text="Backups are saved to C:\ProgramData\MyPOS\backups. Copy this folder to a USB drive regularly - it contains everything the shop needs if this computer is replaced."
                                   Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
