<Window x:Class="Pos.Desktop.Views.AddStaffView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="520" Width="500"
        MinHeight="460" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Staff members log in with their name and a PIN."
                       Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Full name *" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8" Margin="0,4,0,16"
                         Background="{StaticResource Brush.Surface}"
                         BorderBrush="{StaticResource Brush.Border.Default}"
                         BorderThickness="1"
                         FontSize="{StaticResource Font.Size.Body}" />

                <TextBlock Text="Role" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding AvailableRoles}"
                          SelectedItem="{Binding SelectedRole}"
                          Padding="10,8" Margin="0,4,0,4"
                          FontSize="{StaticResource Font.Size.Body}" />
                <TextBlock Text="Cashier can sell. Manager can also manage stock, customers and reports. Admin can also access Settings."
                           Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <TextBlock Text="{Binding PinLabel}" Style="{StaticResource Text.Label}" />
                <PasswordBox x:Name="PinBox"
                             PasswordChanged="OnPinChanged"
                             Padding="10,8" Margin="0,4,0,8"
                             Background="{StaticResource Brush.Surface}"
                             BorderBrush="{StaticResource Brush.Border.Default}"
                             BorderThickness="1"
                             FontSize="{StaticResource Font.Size.Body}" />

                <TextBlock Text="Confirm PIN" Style="{StaticResource Text.Label}" />
                <PasswordBox x:Name="PinConfirmBox"
                             PasswordChanged="OnPinConfirmChanged"
                             Padding="10,8" Margin="0,4,0,4"
                             Background="{StaticResource Brush.Surface}"
                             BorderBrush="{StaticResource Brush.Border.Default}"
                             BorderThickness="1"
                             FontSize="{StaticResource Font.Size.Body}" />

                <TextBlock Text="{Binding PinHelp}"
                           Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <Border Background="{StaticResource Brush.Danger.Subtle}"
                        BorderBrush="{StaticResource Brush.Danger}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Medium}"
                        Padding="10"
                        Margin="0,8,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToCollapsedConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource Brush.Danger}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Body}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel"
                    Style="{StaticResource Button.Secondary}"
                    Padding="16,8" Margin="0,0,8,0" />
            <Button Content="{Binding SaveButtonText}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Style="{StaticResource Button.Primary}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InvertBoolConverter}}" />
        </StackPanel>
    </Grid>
</Window>
