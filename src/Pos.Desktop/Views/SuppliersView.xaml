<UserControl x:Class="Pos.Desktop.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Suppliers" Style="{StaticResource Text.Display}" />
                <TextBlock Text="Who you buy stock from, and what you still owe them."
                           Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0" ToolTip="Refresh">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Refresh}"
                                   FontFamily="{StaticResource Font.Icon}"
                                   FontSize="14" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding AddSupplierCommand}"
                        ToolTip="Add a new supplier">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Add}"
                                   FontFamily="{StaticResource Font.Icon}"
                                   FontSize="14" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="Add supplier" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Medium}"
                Height="36"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{StaticResource Icon.Search}"
                           FontFamily="{StaticResource Font.Icon}"
                           FontSize="14"
                           Foreground="{StaticResource Brush.Text.Tertiary}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="8,0"
                         FontSize="{StaticResource Font.Size.Body}"
                         VerticalContentAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Border Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Large}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Suppliers.Count}" Value="0" />
                                    <Condition Binding="{Binding IsBusy}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DataGrid ItemsSource="{Binding Suppliers}"
                          Style="{StaticResource DataGrid.Default}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="160" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180" />
                        <DataGridTextColumn Header="Owed (KES)"
                                            Binding="{Binding BalanceCents, Converter={StaticResource CentsToShillingsConverter}}"
                                            Width="130"
                                            CellStyle="{StaticResource DataGrid.NumericCell}"
                                            HeaderStyle="{StaticResource DataGrid.NumericColumnHeader}" />
                        <DataGridTemplateColumn Header="" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Edit"
                                                Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Button.Ghost}"
                                                Height="28" Padding="10,0"
                                                Margin="0,0,4,0" />
                                        <Button Content="Remove"
                                                Command="{Binding DataContext.ArchiveSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Button.Ghost}"
                                                Height="28" Padding="10,0"
                                                Foreground="{StaticResource Brush.Danger}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Large}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Suppliers.Count}" Value="0" />
                                    <Condition Binding="{Binding IsBusy}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="420" Margin="24">
                    <TextBlock Text="{StaticResource Icon.People}"
                               FontFamily="{StaticResource Font.Icon}"
                               FontSize="56"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="No suppliers yet"
                               Style="{StaticResource Text.Title}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                    <TextBlock Text="Add the companies you buy stock from. You can then record deliveries against them."
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,6,0,20" />
                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding AddSupplierCommand}"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Add}"
                                       FontFamily="{StaticResource Font.Icon}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="Add your first supplier" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource Text.Caption}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
