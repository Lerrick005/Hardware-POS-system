<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:conv="clr-namespace:Pos.Desktop.Converters">

    <!-- =====================================================================
         POS DESIGN SYSTEM - TOKENS (v2: accessibility pass)
         All text colors meet WCAG AA (4.5:1) against the surfaces they sit on.
         Base body size raised to 14pt for shop-floor readability.
         ===================================================================== -->

    <!-- ========== FONTS ========== -->
    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ========== PALETTE (semantic) ========== -->
    <Color x:Key="Color.Canvas">#F8FAFC</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Sunken">#F1F5F9</Color>
    <Color x:Key="Color.Surface.Hover">#F1F5F9</Color>
    <Color x:Key="Color.Surface.Pressed">#E2E8F0</Color>

    <Color x:Key="Color.Border.Default">#E2E8F0</Color>
    <Color x:Key="Color.Border.Strong">#94A3B8</Color>

    <!-- Text: darkened for readability. Tertiary now 4.9:1 on white. -->
    <Color x:Key="Color.Text.Primary">#0F172A</Color>
    <Color x:Key="Color.Text.Secondary">#334155</Color>
    <Color x:Key="Color.Text.Tertiary">#64748B</Color>
    <Color x:Key="Color.Text.OnAccent">#FFFFFF</Color>

    <Color x:Key="Color.Accent">#0F766E</Color>
    <Color x:Key="Color.Accent.Hover">#0D9488</Color>
    <Color x:Key="Color.Accent.Pressed">#115E59</Color>
    <Color x:Key="Color.Accent.Subtle">#CCFBF1</Color>
    <Color x:Key="Color.Accent.SubtleHover">#99F6E4</Color>

    <Color x:Key="Color.Success">#047857</Color>
    <Color x:Key="Color.Success.Subtle">#D1FAE5</Color>
    <Color x:Key="Color.Danger">#B91C1C</Color>
    <Color x:Key="Color.Danger.Subtle">#FEE2E2</Color>
    <Color x:Key="Color.Warning">#B45309</Color>
    <Color x:Key="Color.Warning.Subtle">#FEF3C7</Color>

    <Color x:Key="Color.Focus">#0D9488</Color>

    <!-- ========== BRUSHES ========== -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="{StaticResource Color.Surface.Sunken}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}" />
    <SolidColorBrush x:Key="Brush.Surface.Pressed" Color="{StaticResource Color.Surface.Pressed}" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.Accent.Subtle}" />
    <SolidColorBrush x:Key="Brush.Accent.SubtleHover" Color="{StaticResource Color.Accent.SubtleHover}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Success.Subtle" Color="{StaticResource Color.Success.Subtle}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="{StaticResource Color.Danger.Subtle}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Warning.Subtle" Color="{StaticResource Color.Warning.Subtle}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}" />

    <!-- ========== TYPE SCALE (bumped for readability) ========== -->
    <sys:Double x:Key="Font.Size.Caption">13</sys:Double>
    <sys:Double x:Key="Font.Size.Micro">13</sys:Double>
    <sys:Double x:Key="Font.Size.Body">14</sys:Double>
    <sys:Double x:Key="Font.Size.BodyLarge">15</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">17</sys:Double>
    <sys:Double x:Key="Font.Size.Title">22</sys:Double>
    <sys:Double x:Key="Font.Size.Display">28</sys:Double>
    <sys:Double x:Key="Font.Size.Numeric">14</sys:Double>
    <sys:Double x:Key="Font.Size.NumericLarge">17</sys:Double>

    <!-- ========== SPACING (4-based) ========== -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>
    <sys:Double x:Key="Space.8">32</sys:Double>
    <sys:Double x:Key="Space.12">48</sys:Double>

    <Thickness x:Key="Space.1.All">4</Thickness>
    <Thickness x:Key="Space.2.All">8</Thickness>
    <Thickness x:Key="Space.3.All">12</Thickness>
    <Thickness x:Key="Space.4.All">16</Thickness>
    <Thickness x:Key="Space.6.All">24</Thickness>
    <Thickness x:Key="Space.8.All">32</Thickness>

    <!-- ========== RADIUS ========== -->
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">6</CornerRadius>
    <CornerRadius x:Key="Radius.Large">10</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- ========== ELEVATION ========== -->
    <DropShadowEffect x:Key="Shadow.1"
                      Color="#0F172A" BlurRadius="4" ShadowDepth="1"
                      Direction="270" Opacity="0.06" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Shadow.2"
                      Color="#0F172A" BlurRadius="8" ShadowDepth="2"
                      Direction="270" Opacity="0.08" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Shadow.3"
                      Color="#0F172A" BlurRadius="24" ShadowDepth="8"
                      Direction="270" Opacity="0.14" RenderingBias="Performance" />

    <!-- ========== COMPONENT SIZES (bumped for touch + readability) ========== -->
    <sys:Double x:Key="Control.Height.Small">32</sys:Double>
    <sys:Double x:Key="Control.Height.Medium">36</sys:Double>
    <sys:Double x:Key="Control.Height.Large">44</sys:Double>
    <sys:Double x:Key="Control.Height.Touch">48</sys:Double>

    <!-- ========== TEXT STYLES ========== -->
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Micro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.BodyLarge" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.BodyLarge}" />
    </Style>

    <Style x:Key="Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Display}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Text.Numeric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Numeric}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="Text.NumericStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.NumericLarge}" />
    </Style>

    <!-- ========== LEGACY ALIASES ========== -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Color.Warning}" />

    <sys:Double x:Key="FontSizeCaption">13</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">17</sys:Double>
    <sys:Double x:Key="FontSizeTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">28</sys:Double>

    <Thickness x:Key="PaddingSmall">8</Thickness>
    <Thickness x:Key="PaddingMedium">16</Thickness>
    <Thickness x:Key="PaddingLarge">24</Thickness>

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">10</CornerRadius>

    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}" />
    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}" />
    <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}" />
    <Style x:Key="DisplayText" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}" />

    <!-- ========== CONVERTERS ========== -->
    <conv:EqualsConverter x:Key="EqualsConverter" />
    <conv:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsedConverter" />
    <conv:InvertBoolConverter x:Key="InvertBoolConverter" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:MilliToUnitsConverter x:Key="MilliToUnitsConverter" />
    <conv:CentsToShillingsConverter x:Key="CentsToShillingsConverter" />
</ResourceDictionary>



